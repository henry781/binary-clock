/*
 * crystal_test.ino - checks the 32.768 kHz crystal: outputs 16.384 kHz on
 * PB3 (OC2A, pin 17; J_ISP1 pin 4 on the clock board).
 *
 * Target: bare ATmega328P, MiniCore, Internal 8 MHz, BOD 2.7 V, Arduino as ISP.
 *
 * Timer2 runs in asynchronous mode (clocked by Y1), CTC mode with
 * OCR2A = 0, prescaler /1, toggling OC2A on every compare match: PB3 toggles
 * at 32 768 Hz, giving a 16.384 kHz square wave. Measure it with an
 * oscilloscope or a frequency counter: a reading of 16.384 kHz shows that
 * the crystal oscillates on its fundamental. The accuracy is that of the
 * instrument (typically 50-100 ppm); the long-term drift is measured with
 * the clock firmware and tools/drift_log.py.
 *
 * Never probe TOSC1/TOSC2 (pins 9/10): the 10-15 pF of a probe stops the
 * oscillator. Probe PB3 only.
 *
 * In CTC mode with OCR2A = 0 there is no overflow, so this sketch produces
 * no 1 Hz tick.
 */

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>

void setup(void)
{
  cli();
  DDRB  = _BV(PB3) | _BV(PB0);
  PORTB = 0;

  TIMSK2 = 0;
  ASSR   = _BV(AS2);        // Timer2 <- TOSC1/TOSC2
  _delay_ms(1000);          // let the 32 kHz oscillator settle

  TCNT2  = 0;
  OCR2A  = 0;
  TCCR2A = _BV(COM2A0) | _BV(WGM21);   // CTC, toggle OC2A on compare match
  TCCR2B = _BV(CS20);                  // prescaler /1
  while (ASSR & (_BV(TCN2UB) | _BV(OCR2AUB) | _BV(TCR2AUB) | _BV(TCR2BUB)))
    ;
  sei();
}

void loop(void)
{
  // Nothing to do: the output is generated by the hardware.
}
